# Mock mode is useful for UI development without a running backend.
VITE_USE_MOCKS=true
VITE_API_BASE_URL=

# For real NASA/IPAC-backed target searches, use:
# VITE_USE_MOCKS=false
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: use a separate backend/tunnel origin for preview and cache images in mock mode.
VITE_ASSET_BASE_URL=
